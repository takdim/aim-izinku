# Flask Configuration
SECRET_KEY=change-this-to-a-secure-random-key
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5002

# MySQL Database Configuration
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/aim_izinku

# Office Geofence (Titik GPS & Radius Toleransi Kantor)
OFFICE_LATITUDE=-5.230188
OFFICE_LONGITUDE=119.503378
OFFICE_RADIUS_METERS=500
OFFICE_NAME="Kampus Fakultas Teknik Unhas Gowa"

# Evidence Storage Directory
EVIDENCE_UPLOAD_FOLDER=storage_evidences

# Development Mode Options (Set true to bypass GPS geofence check during testing)
DEV_BYPASS_GPS_CHECK=false
